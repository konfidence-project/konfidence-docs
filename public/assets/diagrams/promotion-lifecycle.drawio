<mxfile host="65bd71144e">
  <diagram id="promotion-lifecycle" name="Promotion Lifecycle">
    <mxGraphModel dx="1180" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1220" background="#F8FEFF" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;Promotion lifecycle&lt;/font&gt;&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontColor=#0E7FA3;" parent="1" vertex="1">
          <mxGeometry x="510" y="40" width="480" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="drift" value="&lt;b&gt;Drift detected&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;the configuration's controller compares the source vector with the target stage&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8F5FB;strokeColor=#139CC7;strokeWidth=2;fontSize=14;fontColor=#0E7FA3;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="created" value="&lt;b&gt;Promotion created&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;ordinal stamped; source, target, and vector snapshotted and immutable&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=14;fontColor=#92400E;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="440" y="190" width="240" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="note-pending" value="&lt;b&gt;Pending&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;auto-approved promotion before the Approved condition is written&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;dashPattern=6 3;fontSize=12;fontColor=#4B5563;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="440" y="380" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="waiting" value="&lt;b&gt;WaitingForApproval&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;stage sources are gated&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=14;fontColor=#92400E;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="140" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="approved" value="&lt;b&gt;Approved&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;granted through the API, or AutoApproved when requireApproval is false&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=14;fontColor=#92400E;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="830" y="350" width="240" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="execution" value="&lt;b&gt;Serialized execution&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;one promotion in progress per configuration, newest approved ordinal wins&lt;/font&gt;&lt;/div&gt;" style="swimlane;startSize=60;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;dashPattern=6 3;fontSize=14;fontColor=#4B5563;fontStyle=1;rounded=1;arcSize=4;html=1;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="1170" y="110" width="250" height="360" as="geometry"/>
        </mxCell>
        <mxCell id="inprogress" value="&lt;b&gt;InProgress&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;resolves its own target and writes the pinned vector&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#92400E;fontStyle=1;shadow=1;" parent="execution" vertex="1">
          <mxGeometry x="15" y="80" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="blocked" value="&lt;b&gt;Blocked&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;target does not resolve, retried, not terminal&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#92400E;fontStyle=1;shadow=1;" parent="execution" vertex="1">
          <mxGeometry x="15" y="230" width="220" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="terminal" value="&lt;b&gt;Terminal states&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;conditions are the source of truth, state is derived&lt;/font&gt;&lt;/div&gt;" style="swimlane;startSize=60;fillColor=#F9FAFB;strokeColor=#9CA3AF;strokeWidth=2;dashed=1;dashPattern=6 3;fontSize=14;fontColor=#4B5563;fontStyle=1;rounded=1;arcSize=4;html=1;collapsible=0;" parent="1" vertex="1">
          <mxGeometry x="1170" y="570" width="250" height="410" as="geometry"/>
        </mxCell>
        <mxCell id="succeeded" value="&lt;b&gt;Succeeded&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;the target stage now carries the pinned vector&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#92400E;fontStyle=1;shadow=1;" parent="terminal" vertex="1">
          <mxGeometry x="15" y="80" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="failed" value="&lt;b&gt;Failed&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;ended without writing the target stage; PromotionTimedOut is the common reason&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#92400E;fontStyle=1;shadow=1;" parent="terminal" vertex="1">
          <mxGeometry x="15" y="190" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="superseded" value="&lt;b&gt;Superseded&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;locked forever, never approved or executed again&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=15;whiteSpace=wrap;html=1;fillColor=#FFF7E8;strokeColor=#F59E0B;strokeWidth=2;fontSize=13;fontColor=#92400E;fontStyle=1;shadow=1;" parent="terminal" vertex="1">
          <mxGeometry x="15" y="310" width="220" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="retention" value="&lt;b&gt;Retention&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;keepLastPromotions keeps the last terminal promotions per configuration (default 10); ttlAfterFinished optionally deletes them sooner&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F9FAFB;strokeColor=#6B7280;strokeWidth=2;fontSize=14;fontColor=#374151;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="1170" y="1030" width="250" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="recovery" value="&lt;b&gt;Recovery is a fresh promotion&lt;/b&gt;&lt;div&gt;&lt;font style=&quot;font-size: 12px;&quot;&gt;the controller re-evaluates current state and creates a new promotion&lt;/font&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#139CC7;strokeWidth=2;dashed=1;dashPattern=8 4;fontSize=14;fontColor=#0E7FA3;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="760" width="600" height="100" as="geometry"/>
        </mxCell>
