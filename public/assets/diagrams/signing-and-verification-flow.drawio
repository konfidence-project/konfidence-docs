        <!-- Arrow 5: promoted vector -->
        <mxCell id="edge5" value="promoted vector" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="box-promo" target="box-reg3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OCI Registry (target/prod) -->
        <mxCell id="box-reg3" value="&lt;b&gt;OCI Registry (target / prod)&lt;/b&gt;" style="swimlane;fontStyle=1;startSize=36;fillColor=#d5e8d4;strokeColor=#82b366;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1020" width="660" height="100" as="geometry" />
