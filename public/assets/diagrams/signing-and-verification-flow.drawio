        <mxCell id="text-reg2" value="konfidence.io/payment-fleet:dev  [signed]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;fontSize=11;fontFamily=Courier New;" vertex="1" parent="box-reg2">
          <mxGeometry x="10" y="36" width="640" height="52" as="geometry" />
        </mxCell>

        <!-- Arrow 4: reconcile VectorPromotionConfig CR -->
        <mxCell id="edge4" value="reconcile: VectorPromotionConfig CR" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="box-reg2" target="box-promo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Promotion controller -->
        <mxCell id="box-promo" value="&lt;b&gt;Promotion controller&lt;/b&gt;" style="swimlane;fontStyle=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="840" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="text-promo" value="verify source vector before promoting (verifyVector)  → pass or FAIL&#xa;&#xa;Credentials: spec.credentials" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;fontSize=11;fontFamily=Courier New;" vertex="1" parent="box-promo">
          <mxGeometry x="10" y="36" width="640" height="52" as="geometry" />
