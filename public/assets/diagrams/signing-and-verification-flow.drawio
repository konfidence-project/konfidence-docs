        <!-- Arrow 6: reconcile StageConfiguration CR -->
        <mxCell id="edge6" value="reconcile: StageConfiguration CR" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="box-reg3" target="box-stage">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- StageConfig controller -->
        <mxCell id="box-stage" value="&lt;b&gt;StageConfig controller&lt;/b&gt;" style="swimlane;fontStyle=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1200" width="660" height="100" as="geometry" />
        </mxCell>
        <mxCell id="text-stage" value="verify vector before writing Stage (verifyVector)  → pass or FAIL&#xa;&#xa;Credentials: spec.credentials" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;fontSize=11;fontFamily=Courier New;" vertex="1" parent="box-stage">
          <mxGeometry x="10" y="36" width="640" height="52" as="geometry" />
        </mxCell>

        <!-- Arrow 7: reconcile VectorDeployment CR -->
        <mxCell id="edge7" value="reconcile: VectorDeployment CR" style="edgeStyle=orthogonalEdgeStyle;curved=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;endArrow=block;endFill=1;fontSize=11;fontStyle=2;" edge="1" parent="1" source="box-stage" target="box-deploy">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- VectorDeployment controller -->
        <mxCell id="box-deploy" value="&lt;b&gt;VectorDeployment controller&lt;/b&gt;" style="swimlane;fontStyle=1;startSize=36;fillColor=#dae8fc;strokeColor=#6c8ebf;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="1380" width="660" height="120" as="geometry" />
        </mxCell>
        <mxCell id="text-deploy" value="verify vector     KONFIDENCE_DEPLOYMENT_VECTOR_SIGNATURES&#xa;verify artifacts  KONFIDENCE_DEPLOYMENT_ARTIFACT_SIGNATURES&#xa;→ pass or FAIL&#xa;&#xa;Credentials: Secret via env vars" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;fontSize=11;fontFamily=Courier New;" vertex="1" parent="box-deploy">
          <mxGeometry x="10" y="36" width="640" height="72" as="geometry" />
