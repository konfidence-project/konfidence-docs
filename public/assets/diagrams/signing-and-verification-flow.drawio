        <mxCell id="text-reg3" value="konfidence.io/payment-fleet:stable  [signed]" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;spacingLeft=12;fontSize=11;fontFamily=Courier New;" vertex="1" parent="box-reg3">
